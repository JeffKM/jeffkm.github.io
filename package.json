{
  "name": "jeffkm-portfolio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run validate:content && next build",
    "start": "npx serve out",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "validate:content": "tsx scripts/validate-content.ts",
    "test": "npm run type-check && npm run lint && npm run test:e2e",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "dependencies": {
    "@next/mdx": "16.3.0",
    "@types/mdx": "2.0.13",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@tailwindcss/postcss": "4.1.14",
    "@types/node": "24.7.2",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "9.37.0",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "4.1.14",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
